# ========================================================================
# 🏠 MENU SCANNER PRODUCTION CONFIGURATION
# ========================================================================

# Application Configuration
APP_NAME=account-online-frontend
EXTERNAL_PORT=7070
PORT=7069
PM2_STARTUP=true

# ========================================================================
# 🔐 Git Configuration - GitHub with Personal Access Token
# ========================================================================
GIT_USERNAME=5589
GIT_PASSWORD=Mak12pa12
GIT_REPO_URL=https://uatgit.cambodiapostbank.com/developer/frontend/account-online-nextjs.git
GIT_BRANCH=development

# ========================================================================
# 🌐 Next.js Environment Variables
# ========================================================================
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=production

# ========================================================================
# 🔗 API Configuration - NGINX PROXY SETUP
# Frontend calls: http://152.42.219.13:8443/api/* → nginx → backend:9090
# ========================================================================
NEXT_PUBLIC_API_BASE_URL=http://192.168.101.5:7070
BACKEND_API_URL=http://192.168.101.5:7070
NEXT_PUBLIC_API_BASE_URL_IMAGE=http://192.168.101.5:7070

# ========================================================================
# ⚡ Performance Settings
# ========================================================================
NODE_OPTIONS=--max_old_space_size=1024
ENABLE_HOT_RELOAD=false
ENABLE_SOURCE_MAPS=false

# ========================================================================
# ⏱️ API Timeout Configuration (in milliseconds)
# Backend config: connection-timeout-minutes: 5, data-load timeout-hours: 5
# ========================================================================
# Default timeout for all API calls (5 minutes = 300000 ms)
NEXT_PUBLIC_API_TIMEOUT=300000
# Timeout for account creation API (5 minutes = 300000 ms)
# Can be increased if backend takes longer due to AML/KYC processing
NEXT_PUBLIC_ACCOUNT_CREATION_TIMEOUT=300000

# ========================================================================
# 🔧 Build Configuration
# ========================================================================
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# ========================================================================
# 📊 Logging Configuration
# ========================================================================
LOG_LEVEL=info
DEBUG_MODE=false

# ========================================================================
# 🛡️ Security Configuration
# ========================================================================
SECURE_COOKIES=true
TRUST_PROXY=true

# ========================================================================
# 📱 Application URLs (for reference)
# ========================================================================
# Frontend:    http://152.42.219.13:8443
# Backend:     http://152.42.219.13:9090
# Swagger:     http://152.42.219.13:9090/swagger-ui/swagger-ui/index.html
# API Flow:    Frontend → 8443/api/* → nginx proxy → 9090/api/*
# ========================================================================